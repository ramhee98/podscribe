# podscribe configuration
#
# Copy this file to podscribe.conf (next to podscribe.sh) and adjust it:
#
#     cp podscribe.conf.example podscribe.conf
#
# The file is sourced by bash, so use KEY="value" with no spaces around "=".
# Precedence: built-in defaults < config file < command-line arguments.
# The values below are the built-in defaults.

# Whisper model file name. Other options include ggml-large-v3.bin (slower,
# slightly more accurate) or ggml-medium.bin / ggml-small.bin (faster).
MODEL_NAME="ggml-large-v3-turbo.bin"

# Base URL the model is downloaded from if it isn't in MODELS_DIR yet.
# The file name is appended: "${MODEL_URL}/${MODEL_NAME}".
MODEL_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main"

# Where models are stored. Relative paths are resolved against the script
# directory. Absolute paths and "$HOME/..." also work.
MODELS_DIR="models"

# Spoken language as a whisper language code (de, en, fr, ...), or "auto"
# to detect it.
LANGUAGE="de"

# Prompt used when neither --prompt nor a prompt.txt in the episode folder is
# given. Useful for host names or terms that appear in every episode.
DEFAULT_PROMPT=""

# Which mp3s to transcribe: "newest" (only the most recent file) or "all".
# Override on the command line with --newest / --all.
MODE="newest"

# true = also search subfolders of the given folder. Same as --recursive.
# Hidden folders and the models folder are always skipped. Transcripts are
# saved next to each source file.
RECURSIVE="false"

# How many folder levels below the given folder to search when RECURSIVE is
# true. 1 = only direct subfolders, 0 = unlimited.
MAX_DEPTH="3"

# Where transcripts go when RECURSIVE is true (ignored otherwise):
#   "source" = next to each audio file
#   "base"   = all in the folder given on the command line, named after their
#              subfolder path, e.g. season2/ep05.mp3 -> season2_ep05.txt
# Override on the command line with --output source|base.
OUTPUT_LOCATION="source"

# With OUTPUT_LOCATION="base": what replaces "/" between subfolder names in
# transcript file names, e.g. "_" (season2_ep05.txt) or " - " (season2 - ep05.txt).
OUTPUT_SEPARATOR="_"

# Other audio formats (besides mp3), separated by commas or spaces. They're
# offered when a folder has no mp3s, and listed in speaker mode. wav and m4a
# are always included.
AUDIO_EXTENSIONS="wav,m4a,flac,aac"

# Transcript formats to write next to each mp3, separated by spaces or commas.
# Supported: txt srt vtt lrc csv json
OUTPUT_FORMATS="txt"

# Number of CPU threads for whisper-cli. Empty = all CPU cores.
THREADS=""

# true = re-transcribe episodes that already have transcripts and replace them.
# false = skip episodes whose transcripts (all OUTPUT_FORMATS) already exist.
OVERWRITE="false"

# true = keep the converted 16 kHz mono WAV as <episode>.wav next to the mp3.
KEEP_WAV="false"

# --- Speaker mode -------------------------------------------------------------
# For podcasts recorded with a separate track per speaker (one mic each).
# podscribe lists the audio files in the folder, you pick the host and guest
# tracks, and it writes one transcript labelled by speaker. Needs python3.

# true = always use speaker mode. Same as passing --speakers.
DIARIZE="false"

# How much louder (in dB) a track must be to count as the one speaking. Each
# mic also picks up the other person, just quieter, so this decides which
# track a sentence really came from. Lower it (e.g. 3) if the mics were close
# together and speech goes missing. Raise it (e.g. 10) if sentences show up
# twice, once per speaker.
ENERGY_MARGIN_DB="6"

# Who speaks first in the episode ("first") or last ("last"). Used to check
# that you picked the right host track. If not, you're asked whether to swap.
HOST_SPEAKS="first"

# Speaker names used in the transcript.
HOST_LABEL="Host"
GUEST_LABEL="Guest"

# true = start each paragraph with its time, like "[00:01:23] Host: ...".
SPEAKER_TIMESTAMPS="true"

# true = start the .txt transcript with the speech stats. In speaker mode:
#   Talk ratio: Host 38% (16:04, 2'310 words) / Gast 62% (26:13, 3'870 words)
#   Silence/other: 01:12
#   Speaking speed: Host 144 wpm / Gast 148 wpm, average 146 wpm
# For single files:
#   Speech: 41:05 (silence/other 01:12)
#   Words: 6'180
#   Speaking speed: 150 wpm
# These are always shown in the summary after transcribing.
RATIO_IN_TRANSCRIPT="false"
